          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "wz4dwgjmbjlezdix6szuxc5a3y-bpnhsueyaxoeddnwbcoskzogae.datawarehouse.fabric.microsoft.com",
              "artifactId": "db976a15-63e3-454a-aa5f-3d2b2bbc1c22",
              "workspaceId": "5079da0b-0598-41dc-8db6-089d2565c601"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "DROP TABLE IF EXISTS dbo.fact_taxi_daily;\nCREATE TABLE dbo.fact_taxi_daily AS\nSELECT\n    pickup_date,\n    PULocationID,\n    COUNT(PULocationID) AS trip_count,\n    SUM(fare_amount) AS sum_fare_amount,\n    SUM(tip_amount) AS sum_tip_amount,\n    SUM(total_amount) AS sum_total_amount,\n    SUM(CAST(is_invalid_duration AS INT)) AS invalid_duration_trips,\n    SUM(CAST(is_non_positive_amount AS INT)) AS non_positive_amount_trips,\n    SUM(CAST(is_outlier_amount AS INT)) AS outlier_amount_trips,\n    SUM(CAST(is_outlier_duration AS INT)) AS outlier_duration_trips,\n    SUM(trip_distance) AS sum_trip_distance,\n    AVG(CASE is_zero_distance WHEN 0 THEN trip_distance END) AS avg_trip_distance,\n    AVG(CASE is_outlier_duration WHEN 0 THEN duration_min END) AS avg_duration_min,\n    AVG(CASE WHEN is_non_positive_amount = 0 AND is_outlier_amount = 0 THEN fare_amount END) AS avg_fare_amount,\n    SUM(CASE payment_type WHEN 4 THEN total_amount END) AS dispute_amount,\n    SUM(CASE WHEN payment_type = 4 THEN 1 ELSE 0 END) AS dispute_trips,\n    COUNT(CASE is_zero_distance WHEN 1 THEN is_zero_distance END) AS zero_distance_trips\nFROM lh_silver.dbo.taxi\nGROUP BY pickup_date, PULocationID;",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        }
